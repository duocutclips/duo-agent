# Roblox Clip Factory configuration.
# Copy this file to .env (same folder) and fill in what you have. Every key is optional:
# the app opens and works offline without any of them, and shows what is not configured.
# Never commit .env. It is listed in .gitignore.

# --- Claude (campaign analysis, ideas, scripts) --------------------------------------------
# https://console.anthropic.com/  -> API keys
ANTHROPIC_API_KEY=
# Model used for analysis/ideas/scripts.
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side fallback when a request is refused: "default" or "off".
ANTHROPIC_REFUSAL_FALLBACK=default

# --- ElevenLabs (natural AI narration) -----------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional default voice id (you can also pick voices in the Voice page).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Speech-to-text with word timestamps (optional) ----------------------------------------
# Any OpenAI-compatible /audio/transcriptions endpoint that supports word timestamps.
# Without it, word timings come from ElevenLabs or are estimated from the audio.
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# --- Publishing (optional, official APIs only) ---------------------------------------------
# OAuth 2.0 access token with the youtube.upload scope. Uploads are always private.
YOUTUBE_ACCESS_TOKEN=

# --- Local paths and runtime ---------------------------------------------------------------
# Where the database, media copies, caches and renders live (default: ./data).
CLIP_FACTORY_DATA_DIR=
# Default: ./logs and ./exports at the repository root.
CLIP_FACTORY_LOGS_DIR=
CLIP_FACTORY_EXPORTS_DIR=
# Leave empty to find ffmpeg/ffprobe on PATH. On Windows e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=
# Backend HTTP server (the desktop app picks a free port and a random token itself).
CLIP_FACTORY_HOST=127.0.0.1
CLIP_FACTORY_PORT=8765
CLIP_FACTORY_API_TOKEN=
# Timeouts in seconds.
CLIP_FACTORY_HTTP_TIMEOUT=60
CLIP_FACTORY_FFMPEG_TIMEOUT=900
